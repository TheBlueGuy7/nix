{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	"logo": {
		"source": "~/.config/fastfetch/nix-snowflake-colours.png",
		"type": "kitty-direct",
       	        "width": 26,
      	        "height": 12,
		"padding": {
			"top": 1,
			"left": 1
		}
	},
	"display": {
		"separator": "  "
	},
	"modules": [
		{
			"type": "os",
			"key": "╭─",
			"keyColor": "blue"
		},
		{
			"type": "kernel",
			"key": "├─",
			"format": "{1} {2}",
			"keyColor": "blue"
		},
		{
			"type": "packages",
			"key": "├─󰮯",
			"keyColor": "blue"
		},
		{
			"type": "de",
			"key": "├─",
			"keyColor": "blue"
		},
		{
			"type": "wm",
			"key": "╰─",
			"keyColor": "blue"
		},
	//	{
	//		"type": "lm",
