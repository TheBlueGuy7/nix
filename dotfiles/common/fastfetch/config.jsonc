		//	"type": "brightness",
		// 	"key": "├─󰃞",
		// 	"keyColor": "green"
		// },
		 {
		 	"type": "battery",
		 	"key": "├─",
		 	"keyColor": "magenta"
		 },
		 {
		 	"type": "poweradapter",
		 	"key": "├─",
		 	"keyColor": "magenta"
		 },
		 {
		 	"type": "gamepad",
		 	"key": "├─",
		 	"keyColor": "magenta"
		 },
		 {
		 	"type": "bluetooth",
		 	"key": "├─",
		 	"keyColor": "magenta"
		 },
	//	 {
	//	 	"type": "sound",
	//	 	"key": "├─",
	//	 	"keyColor": "magenta"
	//	 },

		{
			"type": "terminalfont",
			"key": "├─",
			"keyColor": "magenta"
		},
		{
			"type": "shell",
			"key": "╰─",
			"keyColor": "magenta"
		},
		"break",
		{
			"type": "host",
			"key": "╭─",
			"keyColor": "cyan"
		},
		{
			"type": "cpu",
			"key": "├─󰍛",
			"keyColor": "cyan"
		},
		{
			"type": "gpu",
			"key": "├─󰘚",
			"keyColor": "cyan"
		},
