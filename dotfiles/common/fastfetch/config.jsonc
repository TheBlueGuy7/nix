		//	"keyColor": "magenta"
		// },
		"break",

         {
			"type": "terminal",
			"key": "╭─",
			"keyColor": "magenta"
		 },
		 {
		 	"type": "disk",
			"key": "├─",
		 	"keyColor": "magenta"
		 },
