configuration {
  modi: "drun,run,window";
  show-icons: true;
  font: "JetBrainsMono Nerd Font 13";
  icon-theme: "Papirus-Dark";
  display-drun: "Apps";
  display-run: "Run";
  display-window: "Win";
  drun-display-format: "{name}";
  window-format: "{w}  {t}";
  matching: "fuzzy";
  sort: true;
  scrollbar: false;
  cycle: true;
  fake-transparency: false;
  kb-row-up: "Up";
  kb-row-down: "Down";
  kb-accept-entry: "Return,KP_Enter";
  kb-cancel: "Escape,Super+space";
}

@theme "default"

* {
  bg:        #0f1115;
  bg-sel:    #1b1e25;
  fg:        #cdd6e1;
  fg-dim:    #888888;
  accent:    #7aa2f7;
  urgent:    #b85a5a;
  border:    #35373d;
  red:       @urgent;
  blue:      @accent;
  green:     @fg-dim;
  yellow:    @accent;
  magenta:   @accent;
  cyan:      @accent;
  black:     @bg;
  white:     @fg;
  font:      "JetBrainsMono Nerd Font 13";

  background:       @bg;
  foreground:       @fg;
  background-color: @bg;
  text-color:       @fg;

  lightbg:  @bg-sel;
  lightfg:  @fg;

  urgent-foreground:       @fg;
  urgent-background:       @bg;
  alternate-urgent-foreground:     @fg;
  alternate-urgent-background:     @bg;
  selected-urgent-foreground:       @fg;
  selected-urgent-background:      @urgent;

  normal-foreground:               @fg;
  normal-background:               @bg;
  alternate-normal-foreground:     @fg;
  alternate-normal-background:     @bg;
  selected-normal-foreground:       @fg;
  selected-normal-background:      @bg-sel;

  active-foreground:               @fg;
  active-background:               @bg;
  alternate-active-foreground:     @fg;
  alternate-active-background:     @bg;
  selected-active-foreground:       @fg;
  selected-active-background:      @bg-sel;
}

window {
  width: 480px;
  background-color: @bg;
  background:       @bg;
  border: 1;
  border-color: @border;
  border-radius: 0;
  padding: 0;
  children: [ mainbox ];
}

mainbox {
  orientation: vertical;
  children: [ inputbar, listview ];
  padding: 12px;
  spacing: 8px;
  background-color: @bg;
  background:       @bg;
}

inputbar {
  spacing: 8px;
  padding: 8px 12px;
  background-color: @bg-sel;
  background:       @bg-sel;
  border: 0;
  border-radius: 0;
  children: [ prompt, entry ];
}

prompt {
  text-color: @accent;
  background-color: @bg-sel;
  background:       @bg-sel;
  font: @font;
}

entry {
  text-color: @fg;
  placeholder: "Search...";
  placeholder-color: @fg-dim;
  background-color: @bg-sel;
  background:       @bg-sel;
  font: @font;
}

listview {
  columns: 1;
  lines: 10;
  cycle: true;
  dynamic: true;
  scrollbar: false;
  fixed-height: false;
  border: 0;
  spacing: 2px;
  background-color: @bg;
  background:       @bg;
  text-color: @fg;
}

element {
  orientation: horizontal;
  spacing: 10px;
  padding: 8px 12px;
  border: 0;
  border-radius: 0;
  background-color: transparent;
  background:       transparent;
  text-color: @fg;
}

element selected {
  background-color: @bg-sel;
  background:       @bg-sel;
  text-color: @fg;
}

element selected.urgent {
  background-color: @urgent;
  background:       @urgent;
  text-color: @fg;
}

element-icon {
  size: 18px;
  background-color: transparent;
  background:       transparent;
}

element-text {
  vertical-align: 0.5;
  text-color: inherit;
  background-color: transparent;
  background:       transparent;
}

#scrollbar {
  background-color: @bg;
  background:       @bg;
  text-color: @fg;
  border: 0;
}

#separator {
  background-color: @bg;
  background:       @bg;
  text-color: @fg;
  border: 0;
}

#message {
  background-color: @bg;
  background:       @bg;
  border: 0;
  padding: 0;
  children: [ textbox ];
}

#textbox {
  background-color: @bg;
  background:       @bg;
  text-color: @fg-dim;
  border: 0;
  padding: 8px 12px;
  font: @font;
}

#error-message {
  background-color: @bg;
  background:       @bg;
  text-color: @urgent;
  border: 0;
  padding: 0;
}
